@page
@model ContactModel
@{
    ViewData["Title"] = "Contact";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="display-6 fw-bold mb-2">Contact &amp; Feedback</h1>
            <p class="text-muted mb-4">
                Have a question, player correction, or suggestion for the BritPlayers archive? Submit it below or directly through GitHub.
            </p>

            <!-- Direct GitHub Option -->
            <div class="card bg-light border-0 mb-4 p-3 d-flex flex-row align-items-center justify-content-between">
                <div>
                    <h6 class="mb-1"><i class="bi bi-github me-2"></i>Have a GitHub account?</h6>
                    <small class="text-muted">You can open a public issue or discussion directly on the project repository.</small>
                </div>
                <a href="https://github.com/YOUR_GITHUB_USERNAME/YOUR_REPO/issues/new"
                   target="_blank"
                   rel="noopener"
                   class="btn btn-outline-dark btn-sm ms-3 text-nowrap">
                    Open Issue
                </a>
            </div>

            <!-- HTMX Contact Form Container -->
            <div id="contact-container">
                <form hx-post="/Contact"
                      hx-target="#contact-container"
                      hx-swap="outerHTML"
                      hx-indicator="#loading-spinner">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="name" class="form-label">Your Name / GitHub Handle <span class="text-muted">(Optional)</span></label>
                        <input type="text" class="form-control" id="name" name="Name" placeholder="e.g. chessfan123" />
                    </div>

                    <div class="mb-3">
                        <label for="category" class="form-label">Category</label>
                        <select class="form-select" id="category" name="Category" required>
                            <option value="Correction">Data / Player Correction</option>
                            <option value="Suggestion">Feature / Content Suggestion</option>
                            <option value="Question">General Question</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="title" class="form-label">Summary / Title</label>
                        <input type="text" class="form-control" id="title" name="Title" required placeholder="e.g. Missing tournament result for 1982" />
                    </div>

                    <div class="mb-3">
                        <label for="message" class="form-label">Message Details</label>
                        <textarea class="form-control" id="message" name="Message" rows="5" required placeholder="Please provide details, references, or links..."></textarea>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-send me-1"></i> Submit Message
                        </button>
                        <div id="loading-spinner" class="htmx-indicator spinner-border spinner-border-sm text-primary" role="status">
                            <span class="visually-hidden">Sending...</span>
                        </div>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>