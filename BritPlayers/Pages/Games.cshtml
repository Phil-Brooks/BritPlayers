@page
@model BritPlayers.Pages.GamesModel
@{
    ViewData["Title"] = $"{Model.SelectedPlayer?.Name} - Games";
}
<nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
    <div class="container-fluid px-3">
        <a class="navbar-brand fw-bold me-3" asp-page="/Index">BritPlayers</a>
    </div>
</nav>

<div class="container py-4">
    @if (Model.SelectedPlayer == null)
    {
        <div class="alert alert-info shadow-sm">
            Please select a player from the navigation bar above to view their archive.
        </div>
    }
    else
    {
        <div class="row justify-content-center mb-4">
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <h1 class="display-6 fw-bold mb-2">@Model.SelectedPlayer.Name</h1>
                        <p class="text-muted mb-4">Games collection from this archive.</p>

                    </div>
                </div>
            </div>
        </div>

        <!-- Game Replay Area (Always visible) -->
        <div id="game-viewer-panel" class="mb-4">
            @if (Model.SelectedGame != null)
            {
                <partial name="_GameReplayerPartial" model="Model.SelectedGame" />
            }
            else
            {
                <div class="card shadow-sm border-0 text-center py-5 text-muted">
                    <p class="mb-0"><i class="bi bi-info-circle me-1"></i> No games available to display for this player.</p>
                </div>
            }
        </div>
        <!-- Game List Container (Updated via HTMX) -->
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h2 class="h5 mb-0">Games</h2>
                <div id="loading-spinner" class="htmx-indicator spinner-border spinner-border-sm text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
            <div class="card-body p-0" id="game-list-container">
                <partial name="_GameListPartial" model="Model.Games" />
            </div>
        </div>
    }
</div>