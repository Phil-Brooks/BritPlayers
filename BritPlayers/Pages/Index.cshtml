@page
@model BritPlayers.Pages.IndexModel
@{
    ViewData["Title"] = "BritPlayers";
}

<nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
    <div class="container-fluid px-3">
        <a class="navbar-brand fw-bold me-3" href="/">BritPlayers</a>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            @foreach (var player in Model.Players)
            {
                <a class="nav-link @(Model.SelectedPlayer != null && Model.SelectedPlayer.Slug == player.Slug ? "active fw-semibold" : "")"
                   href="/?player=@player.Slug">@player.Name</a>
            }
        </div>
    </div>
</nav>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-11">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h1 class="display-6 fw-bold mb-2">@Model.SelectedPlayer?.Name</h1>
                    <p class="text-muted mb-4">Player collection from the local BritBase archive.</p>

                    @if (Model.SelectedGame != null)
                    {
                        <div id="game-panel" class="card border-primary bg-light mb-4">
                            <div class="card-body">
                                <h2 class="h5 mb-2">Selected game</h2>
                                <div class="fw-semibold mb-1">@Model.SelectedGame.White vs @Model.SelectedGame.Black</div>
                                <div class="text-muted small mb-2">@Model.SelectedGame.Summary</div>
                                <div class="small text-break">@Model.SelectedGame.Moves</div>
                            </div>
                        </div>
                    }

                    @if (!Model.Games.Any())
                    {
                        <div class="alert alert-warning mb-0">No games found for this player in the local archive.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Date</th>
                                        <th>White</th>
                                        <th>Black</th>
                                        <th>Result</th>
                                        <th>Event</th>
                                        <th>ECO</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var game in Model.Games)
                                    {
                                        <tr>
                                            <td>@game.Date</td>
                                            <td>@game.White</td>
                                            <td>@game.Black</td>
                                            <td>@game.Result</td>
                                            <td>@game.Event</td>
                                            <td>@game.Eco</td>
                                            <td>
                                                <a class="btn btn-sm btn-outline-primary"
                                                   href="/?player=@Model.SelectedPlayer?.Slug&game=@game.Id#game-panel">Load &amp; Play</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
