@page
@model BritPlayers.Pages.IndexModel
@{
    ViewData["Title"] = "Home - BritPlayers";
}

<div class="container py-4">
    <!-- Summary Header -->
    <div class="p-4 mb-4 bg-light rounded-3 shadow-sm border">
        <h1 class="display-6 fw-bold text-dark mb-2">BritPlayers Archive</h1>
        <p class="text-muted mb-0">
            An interactive repository of chess games for British players inspired by the BritBase archive.
            Study the games of British Grandmasters and other notable players using the interactive SAN figurine board replayer which includes Stockfish evaluations.
        </p>
    </div>

    <!-- Tables Row -->
    <div class="row g-4">
        <!-- Grandmasters Table -->
        <div class="col-12 col-lg-6">
            <div class="card shadow-sm border h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title fw-bold mb-0 text-dark">
                        <i class="bi bi-award text-primary me-2"></i>Grandmasters
                    </h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 35%;">Dates</th>
                                <th>Player</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var player in Model.Grandmasters)
                            {
                                <tr>
                                    <td class="text-secondary text-nowrap">@player.Dates</td>
                                    <td>
                                        <a href="/Player?player=@player.Slug" class="fw-semibold text-primary text-decoration-none">
                                            @player.Name
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Other Notable Players Table -->
        <div class="col-12 col-lg-6">
            <div class="card shadow-sm border h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title fw-bold mb-0 text-dark">
                        <i class="bi bi-person-badge text-primary me-2"></i>Other Notable Players
                    </h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 35%;">Dates</th>
                                <th>Player</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var player in Model.OtherNotablePlayers)
                            {
                                <tr>
                                    <td class="text-secondary text-nowrap">@player.Dates</td>
                                    <td>
                                        <a href="/Player?player=@player.Slug" class="fw-semibold text-primary text-decoration-none">
                                            @player.Name
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>