@page
@model BritPlayers.Pages.IndexModel
@{
    ViewData["Title"] = Model.SelectedPlayer != null ? $"{Model.SelectedPlayer.Name} - BritPlayers" : "BritPlayers";
}

<nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
    <div class="container-fluid px-3">
        <a class="navbar-brand fw-bold me-3" asp-page="/Index">BritPlayers</a>
    </div>
</nav>

<div class="container py-4">
    @if (Model.SelectedPlayer == null)
    {
        <div class="alert alert-info shadow-sm">
            Please select a player from the navigation bar above to view their archive.
        </div>
    }
    else
    {
        <div class="row justify-content-center mb-4">
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <h1 class="display-6 fw-bold mb-2">@Model.SelectedPlayer.Name</h1>
                        <p class="text-muted mb-4">Player collection from the local BritBase archive.</p>

                        @if (Model.SelectedGame != null)
                        {
                            <div id="game-panel" class="card border-primary bg-light mb-0">
                                <div class="card-body">
                                    <h2 class="h5 mb-2">Selected game</h2>
                                    <div class="fw-semibold mb-1">@Model.SelectedGame.White vs @Model.SelectedGame.Black</div>
                                    <div class="text-muted small mb-2">@Model.SelectedGame.Summary</div>
                                    <div class="small text-break">@Model.SelectedGame.Moves</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Game Replay Area (Target for Step 5) -->
        <div id="game-viewer-panel" class="mb-4">
            <!-- Replay board will appear here when a game is loaded -->
        </div>

        <!-- Game List Container (Updated via HTMX) -->
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h2 class="h5 mb-0">Games</h2>
                <div id="loading-spinner" class="htmx-indicator spinner-border spinner-border-sm text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
            <div class="card-body p-0" id="game-list-container">
                <partial name="_GameListPartial" model="Model.Games" />
            </div>
        </div>
    }
</div>