@page
@model BritPlayers.Pages.IndexModel
@{
    ViewData["Title"] = "Home - BritPlayers";
}

<div class="container py-5">
    <div class="p-5 mb-4 bg-light rounded-3 shadow-sm border">
        <div class="container-fluid py-3">
            <h1 class="display-5 fw-bold text-dark">BritPlayers Archive</h1>
            <p class="col-md-8 fs-5 text-muted">
                An interactive British chess game repository powered by the BritBase historical collection.
                Explore grandmaster games, step through moves with the interactive figurine replayer, and study historical matches.
            </p>
            <a class="btn btn-primary btn-lg" href="/Games?player=murray-chandler">
                <i class="bi bi-play-circle me-1"></i> Explore Games
            </a>
        </div>
    </div>

    <div class="row g-4 py-2">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title fw-bold"><i class="bi bi-people text-primary me-2"></i>Featured Players</h5>
                    <p class="card-text text-muted">Browse historical archives for Tony Miles, Nigel Short, Murray Chandler, Paul Littlewood, and Ian Wells.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title fw-bold"><i class="bi bi-diagram-3 text-primary me-2"></i>PGN Replayer</h5>
                    <p class="card-text text-muted">Interactive SAN figurine board viewer with move step controls and flip orientation support.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title fw-bold"><i class="bi bi-database text-primary me-2"></i>BritBase Source</h5>
                    <p class="card-text text-muted">Parsed directly from historical BritBase PGN files preserved from British chess tournaments.</p>
                </div>
            </div>
        </div>
    </div>
</div>