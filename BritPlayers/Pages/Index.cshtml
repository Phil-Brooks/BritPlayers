@page
@model BritPlayers.Pages.IndexModel
@{
    ViewData["Title"] = "Home - BritPlayers";
}

<div class="container py-4">
    <!-- Summary Header -->
    <div class="p-4 mb-4 bg-light rounded-3 shadow-sm border">
        <h1 class="display-6 fw-bold text-dark mb-2">BritPlayers Archive</h1>
        <p class="text-muted mb-0">
            An interactive repository of chess games for British players inspired by the BritBase archive.
            Study the games of British Grandmasters and other notable players using the interactive SAN figurine board replayer which includes Stockfish evaluations.
        </p>
    </div>

    <div class="card shadow-sm border">
        <div class="card-header bg-white py-3">
            <h2 class="h5 card-title fw-bold mb-0 text-dark">
                <i class="bi bi-people text-primary me-2"></i>Players
            </h2>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Player</th>
                        <th scope="col">Title</th>
                        <th scope="col" class="d-none d-md-table-cell">Dates</th>
                        <th scope="col" class="d-none d-md-table-cell">
                            FIDE Grade<br />
                            <small class="fw-normal text-muted">as of @Model.FideRatings.AsOf.ToString("d MMM yyyy")</small>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var player in Model.Players)
                    {
                        <tr>
                            <td>
                                <a href="/Player?player=@player.Slug" class="fw-semibold text-primary text-decoration-none">
                                    @player.Name
                                </a>
                            </td>
                            <td class="text-secondary text-nowrap">@player.TitleAbbreviation</td>
                            <td class="text-secondary text-nowrap d-none d-md-table-cell">@player.Dates</td>
                            <td class="text-nowrap d-none d-md-table-cell">
                                @if (Model.FideRatings.Players.TryGetValue(player.Slug, out var fideRating))
                                {
                                    <a href="https://ratings.fide.com/profile/@fideRating.FideId" target="_blank" rel="noopener noreferrer" class="text-decoration-none">
                                        @fideRating.Standard
                                    </a>
                                }
                                else
                                {
                                    <span class="text-secondary">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>