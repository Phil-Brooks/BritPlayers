@page
@model BritPlayers.Pages.PlayerModel
@{
    ViewData["Title"] = $"{Model.CurrentPlayer.Name} - Profile";
}

<div class="container py-4">
    <!-- Header Card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                {
                    <img src="@Model.PhotoUrl"
                         alt="@Model.CurrentPlayer.Name"
                         class="rounded-circle shadow-sm border"
                         style="width: 90px; height: 90px; object-fit: cover;" />
                }
                <div>
                    <span class="badge bg-primary text-uppercase mb-2">@Model.CurrentPlayer.Title</span>
                    <h1 class="display-6 fw-bold mb-1">@Model.CurrentPlayer.Name</h1>
                    <p class="text-muted mb-0">@Model.CurrentPlayer.Dates &bull; Archive collection: <strong>@Model.GameCount games</strong></p>
                </div>
            </div>

            <!-- "View Games" CTA Button -->
            <div>
                <a class="btn btn-primary btn-lg shadow-sm" href="/Games?player=@Model.CurrentPlayer.Slug">
                    <i class="bi bi-play-circle me-1"></i> View Games &amp; Replayer &raquo;
                </a>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4" aria-label="Player archive statistics">
        <div class="col-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body py-3">
                    <div class="text-muted small">Wins</div>
                    <div class="fs-4 fw-bold text-success">@Model.Wins</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body py-3">
                    <div class="text-muted small">Draws</div>
                    <div class="fs-4 fw-bold">@Model.Draws</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body py-3">
                    <div class="text-muted small">Losses</div>
                    <div class="fs-4 fw-bold text-danger">@Model.Losses</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body py-3">
                    <div class="text-muted small">Archive years</div>
                    <div class="fs-4 fw-bold">
                        @if (Model.EarliestGameYear.HasValue && Model.LatestGameYear.HasValue)
                        {
                            @Model.EarliestGameYear <text>–</text> @Model.LatestGameYear
                        }
                        else
                        {
                            <text>—</text>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Biography / Text Content Card -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="mb-0 fw-semibold"><i class="bi bi-file-text me-2 text-primary"></i>Biographical Notes &amp; History</h5>
        </div>
        <div class="card-body p-4 fs-6 leading-relaxed">
            @Html.Raw(Model.BioHtml)
        </div>
    </div>
</div>