@model BritPlayers.Models.ChessGame

<style>
    .chess-table {
        width: 100%;
        border-collapse: collapse;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        font-size: 0.92rem;
    }

        .chess-table tbody tr {
            border-bottom: 1px solid #f1f3f5;
            height: 32px;
        }

            .chess-table tbody tr:hover {
                background-color: #f8f9fa;
            }

    .move-num {
        width: 44px;
        text-align: right;
        padding-right: 12px;
        color: #adb5bd;
        font-weight: 600;
        font-size: 0.85rem;
        user-select: none;
        vertical-align: middle;
    }

    .move-cell {
        width: 45%;
        padding: 2px 4px;
        cursor: pointer;
        vertical-align: middle;
    }

    /* Flex wrapper inside cell for perfect alignment */
    .move-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 3px 8px;
        border-radius: 4px;
        transition: background-color 0.1s ease;
    }

        .move-inner:hover {
            background-color: #e9ecef;
        }

    /* Active move styling */
    .active-move .move-inner {
        background-color: #0d6efd !important;
        color: #ffffff !important;
        font-weight: 600;
    }

    .active-move .piece-glyph {
        color: #ffffff !important;
    }

    .active-move .eval-pill {
        background-color: rgba(255, 255, 255, 0.22) !important;
        color: #ffffff !important;
        border-color: transparent !important;
    }

    /* Modern Evaluation Pill Badge */
    .eval-pill {
        display: inline-block;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
        font-size: 0.72rem;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
        text-align: right;
        min-width: 48px;
        padding: 1px 6px;
        border-radius: 12px;
        background-color: #f1f3f5;
        color: #495057;
        border: 1px solid #e9ecef;
        user-select: none;
        letter-spacing: -0.2px;
    }

        /* Subtle advantage tints */
        .eval-pill.eval-white {
            background-color: #e8f5e9;
            color: #2e7d32;
            border-color: #c8e6c9;
        }

        .eval-pill.eval-black {
            background-color: #ffebee;
            color: #c62828;
            border-color: #ffcdd2;
        }

        .eval-pill.eval-mate {
            background-color: #fff3e0;
            color: #e65100;
            border-color: #ffe0b2;
            font-weight: 700;
        }

    .piece-glyph {
        font-size: 1.05rem;
        margin-right: 2px;
        vertical-align: -1px;
    }

    .board-controls {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 0.5rem;
        width: min(100%, 360px);
        margin: 1rem auto 0;
    }

        .board-controls .btn {
            width: 100%;
            min-height: 46px;
            font-size: 1.6rem;
            line-height: 1;
            border-radius: 0.6rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
        }
</style>

<div class="card shadow-sm border-primary">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0">@Model.White vs @Model.Black</h5>
            <small>@Model.Event (@Model.Date) &bull; Result: <strong>@Model.Result</strong> &bull; ECO: @Model.Eco</small>
        </div>
        <button type="button" class="btn-close btn-close-white" onclick="document.getElementById('game-viewer-panel').innerHTML = ''" aria-label="Close"></button>
    </div>

    <div class="card-body">
        <div class="row">
            <!-- Chessboard Column -->
            <div class="col-lg-5 col-md-6 text-center">
                <div id="board" style="width: 380px; max-width: 100%; margin: 0 auto;"></div>

                <!-- Navigation Controls -->
                <div class="board-controls" role="group" aria-label="Move controls">
                    <button id="btn-start" class="btn btn-outline-secondary" title="First move">&laquo;</button>
                    <button id="btn-prev" class="btn btn-outline-secondary" title="Previous move">&lsaquo;</button>
                    <button id="btn-flip" class="btn btn-outline-secondary" title="Flip board">&#8645;</button>
                    <button id="btn-next" class="btn btn-outline-secondary" title="Next move">&rsaquo;</button>
                    <button id="btn-end" class="btn btn-outline-secondary" title="Last move">&raquo;</button>
                </div>
                <div class="text-muted small mt-2">Use Left / Right arrow keys to step moves</div>
            </div>

            <!-- Two-Column Notation Table -->
            <div class="col-lg-7 col-md-6 mt-3 mt-md-0">
                <div class="card h-100 shadow-sm border">
                    <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
                        <strong class="text-dark"><i class="bi bi-list-ol me-1"></i> Moves</strong>
                        <span class="badge bg-secondary">Figurine SAN &bull; Eval</span>
                    </div>
                    <div class="card-body p-0 overflow-auto" id="moves-container" style="max-height: 420px;">
                        <table class="chess-table">
                            <tbody id="moves-table-body">
                                <!-- Populated dynamically -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Raw PGN moves -->
<div id="pgn-data" class="d-none">@Model.Moves</div>

<script>
    (function () {
        function initReplayer() {
            if (typeof Chess === 'undefined' || typeof Chessboard === 'undefined') {
                setTimeout(initReplayer, 50);
                return;
            }

            try {
                const rawPgnText = document.getElementById('pgn-data').textContent.trim();

                // 1. Extract all [%eval ...] scores
                const evalMatches = [];
                const evalRegex = /\[%eval\s+([#+-]?\d+(?:\.\d+)?)[^\]]*\]/g;
                let match;
                while ((match = evalRegex.exec(rawPgnText)) !== null) {
                    evalMatches.push(match[1]);
                }

                // 2. Strip comments, variations, NAGs for chess.js
                let cleanMoves = rawPgnText
                    .replace(/\{[^}]*\}/gs, '')
                    .replace(/\([^)]*\)/g, '')
                    .replace(/\$\d+/g, '');

                const chess = new Chess();
                chess.load_pgn(cleanMoves, { sloppy: true });

                const history = chess.history({ verbose: true });

                chess.reset();
                const fens = [chess.fen()];
                for (let i = 0; i < history.length; i++) {
                    chess.move(history[i]);
                    fens.push(chess.fen());
                }

                let currentMoveIndex = 0;

                const board = Chessboard('board', {
                    position: 'start',
                    showNotation: true,
                    pieceTheme: 'https://chessboardjs.com/img/chesspieces/wikipedia/{piece}.png'
                });

                setTimeout(() => { board.resize(); }, 50);

                function toFigurine(san) {
                    if (!san) return '';
                    const glyphs = { 'K': '♔', 'Q': '♕', 'R': '♖', 'B': '♗', 'N': '♘' };
                    const firstChar = san.charAt(0);
                    if (glyphs[firstChar]) {
                        return `<span class="piece-glyph">${glyphs[firstChar]}</span>${san.substring(1)}`;
                    }
                    return san;
                }

                // Format eval badge with subtle advantage coloring
                function renderEvalBadge(val) {
                    if (!val) return '';
                    let extraClass = '';
                    const num = parseFloat(val);

                    if (val.startsWith('#')) {
                        extraClass = 'eval-mate';
                    } else if (!isNaN(num)) {
                        if (num >= 2.0) extraClass = 'eval-white';
                        else if (num <= -2.0) extraClass = 'eval-black';
                    }

                    return `<span class="eval-pill ${extraClass}">${val}</span>`;
                }

                // 3. Build notation table
                const tbody = document.getElementById('moves-table-body');
                tbody.innerHTML = '';

                for (let i = 0; i < history.length; i += 2) {
                    const moveNum = Math.floor(i / 2) + 1;
                    const whiteMove = history[i];
                    const blackMove = history[i + 1];

                    const whiteEval = evalMatches[i] || '';
                    const blackEval = evalMatches[i + 1] || '';

                    const tr = document.createElement('tr');

                    // Move number
                    const tdNum = document.createElement('td');
                    tdNum.className = 'move-num';
                    tdNum.textContent = moveNum;
                    tr.appendChild(tdNum);

                    // White move
                    const tdWhite = document.createElement('td');
                    tdWhite.className = 'move-cell';
                    tdWhite.setAttribute('data-move-idx', (i + 1).toString());
                    tdWhite.innerHTML = `
                            <div class="move-inner">
                                <span>${toFigurine(whiteMove.san)}</span>
                                ${renderEvalBadge(whiteEval)}
                            </div>`;
                    tr.appendChild(tdWhite);

                    // Black move
                    const tdBlack = document.createElement('td');
                    tdBlack.className = 'move-cell';
                    if (blackMove) {
                        tdBlack.setAttribute('data-move-idx', (i + 2).toString());
                        tdBlack.innerHTML = `
                                <div class="move-inner">
                                    <span>${toFigurine(blackMove.san)}</span>
                                    ${renderEvalBadge(blackEval)}
                                </div>`;
                    } else {
                        tdBlack.innerHTML = '';
                    }
                    tr.appendChild(tdBlack);

                    tbody.appendChild(tr);
                }

                function highlightCurrentMove() {
                    document.querySelectorAll('.move-cell').forEach(el => {
                        const idx = parseInt(el.getAttribute('data-move-idx') || '0');
                        if (idx === currentMoveIndex) {
                            el.classList.add('active-move');
                            el.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
                        } else {
                            el.classList.remove('active-move');
                        }
                    });
                }

                function goToMove(index) {
                    if (index < 0) index = 0;
                    if (index >= fens.length) index = fens.length - 1;
                    currentMoveIndex = index;
                    board.position(fens[currentMoveIndex]);
                    highlightCurrentMove();
                }

                document.getElementById('btn-start').onclick = () => goToMove(0);
                document.getElementById('btn-prev').onclick = () => goToMove(currentMoveIndex - 1);
                document.getElementById('btn-next').onclick = () => goToMove(currentMoveIndex + 1);
                document.getElementById('btn-end').onclick = () => goToMove(fens.length - 1);
                document.getElementById('btn-flip').onclick = () => board.flip();

                tbody.addEventListener('click', (e) => {
                    const target = e.target.closest('.move-cell');
                    if (target && target.hasAttribute('data-move-idx')) {
                        const moveIdx = parseInt(target.getAttribute('data-move-idx'));
                        goToMove(moveIdx);
                    }
                });

                const keyHandler = (e) => {
                    if (e.key === 'ArrowRight') {
                        goToMove(currentMoveIndex + 1);
                    } else if (e.key === 'ArrowLeft') {
                        goToMove(currentMoveIndex - 1);
                    }
                };
                window.removeEventListener('keydown', window._chessKeyHandler);
                window._chessKeyHandler = keyHandler;
                window.addEventListener('keydown', keyHandler);

            } catch (err) {
                console.error("Chess replayer initialization error:", err);
                document.getElementById('moves-table-body').innerHTML =
                    `<tr><td colspan="3" class="text-danger p-2">Error rendering moves: ${err.message}</td></tr>`;
            }
        }

        initReplayer();
    })();
</script>